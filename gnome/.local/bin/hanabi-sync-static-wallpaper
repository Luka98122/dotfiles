#!/bin/bash
CACHE_DIR="$HOME/.cache/hanabi-wallpaper"
FRAME_FILE="$CACHE_DIR/firstframe.png"
STATE_FILE="$CACHE_DIR/last-video-path"

mkdir -p "$CACHE_DIR"

sync_wallpaper() {
    local video_path
    video_path=$(gsettings get io.github.jeffshee.hanabi-extension video-path | tr -d "'")

    if [ -z "$video_path" ] || [ ! -f "$video_path" ]; then
        return
    fi

    local last_path
    last_path=$(cat "$STATE_FILE" 2>/dev/null)
    if [ "$video_path" = "$last_path" ] && [ -f "$FRAME_FILE" ]; then
        return
    fi

    ffmpeg -y -loglevel error -i "$video_path" -vframes 1 -update 1 "$FRAME_FILE"

    if [ $? -eq 0 ] && [ -f "$FRAME_FILE" ]; then
        local uri="file://${FRAME_FILE}"
        gsettings set org.gnome.desktop.background picture-uri "$uri"
        gsettings set org.gnome.desktop.background picture-uri-dark "$uri"
        echo "$video_path" > "$STATE_FILE"
    fi
}

sync_wallpaper
exec gsettings monitor io.github.jeffshee.hanabi-extension video-path | while read -r line; do
    sync_wallpaper
done
